services:
  app:
    dir: handler
    compute:
      trigger: http
      handler: app.handler
    network:
      - binding: NET
        vpcId: "{{ terraform.base.vpc_id }}"
        subnetIds: {{ terraform.base.subnet_ids|json }}
    queues:
      - { binding: JOBS }
    databases:
      - binding: DB
        driver: dynamodb
        partitionKey: { name: pk }
{% if paid %}
      - { binding: PG, driver: postgres }
      - { binding: SQL, driver: postgres, engine: aurora, network: NET }
    keyvalue:
      - { binding: CACHE, driver: redis, network: NET }
{% endif %}
    objects:
      - { binding: FILES }
    secrets:
      - binding: SECRETS
        provider: aws-ssm
        entries:
          pepper: { generate: { bytes: 32, encoding: base64 } }
