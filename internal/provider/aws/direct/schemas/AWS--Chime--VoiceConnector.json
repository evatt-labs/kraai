      "description": "The AWS Region in which the Voice Connector is created.",
      "enum": [
        "us-east-1",
        "us-west-2",
        "ca-central-1",
        "eu-central-1",
        "eu-west-1",
        "eu-west-2",
        "ap-northeast-2",
